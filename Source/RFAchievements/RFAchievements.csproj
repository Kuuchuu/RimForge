<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<OutputType>Library</OutputType>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NoStdLib>false</NoStdLib>
		<LangVersion>latest</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<RootNamespace>Rimforge.Achievements</RootNamespace>
		<AssemblyName>ZRFAchievements</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="VanillaAchievments">
			<HintPath Condition="Exists('C:/Program Files (x86)/Steam/steamapps/common/RimWorld/Mods/VanillaAchievementsExpanded/1.6/Assemblies/AchievementsExpanded.dll')">C:/Program Files (x86)/Steam/steamapps/common/RimWorld/Mods/VanillaAchievementsExpanded/1.6/Assemblies/AchievementsExpanded.dll</HintPath>
			<HintPath Condition="Exists('C:/Program Files (x86)/Steam/steamapps/workshop/content/294100/2288125657/1.6/Assemblies/AchievementsExpanded.dll')">C:/Program Files (x86)/Steam/steamapps/workshop/content/294100/2288125657/1.6/Assemblies/AchievementsExpanded.dll</HintPath>
			<HintPath Condition="Exists('C:/Program Files/Steam/steamapps/common/RimWorld/Mods/VanillaAchievementsExpanded/1.6/Assemblies/AchievementsExpanded.dll')">C:/Program Files/Steam/steamapps/common/RimWorld/Mods/VanillaAchievementsExpanded/1.6/Assemblies/AchievementsExpanded.dll</HintPath>
			<HintPath Condition="Exists('C:/Program Files/Steam/steamapps/workshop/content/294100/2288125657/1.6/Assemblies/AchievementsExpanded.dll')">C:/Program Files/Steam/steamapps/workshop/content/294100/2288125657/1.6/Assemblies/AchievementsExpanded.dll</HintPath>
			<HintPath Condition="Exists('$(RIMWORLD_BASE_PATH)/Mods/VanillaAchievementsExpanded/1.6/Assemblies/AchievementsExpanded.dll')">$(RIMWORLD_BASE_PATH)/Mods/VanillaAchievementsExpanded/1.6/Assemblies/AchievementsExpanded.dll</HintPath>
			<HintPath Condition="Exists('$(RIMWORLD_BASE_PATH)/../../workshop/content/294100/2288125657/1.6/Assemblies/AchievementsExpanded.dll')">$(RIMWORLD_BASE_PATH)/../../workshop/content/294100/2288125657/1.6/Assemblies/AchievementsExpanded.dll</HintPath>
			<Private>True</Private>
		</Reference>
		<PackageReference Include="Lib.Harmony" Version="2.3.6" ExcludeAssets="runtime" />
		<ProjectReference Include="..\RimForge\RimForge.csproj">
			<CopyLocal>false</CopyLocal>
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4528" />
  </ItemGroup>    
  
	<!-- Output -->
	<PropertyGroup>
		<DebugType>none</DebugType>
		<OutputPath>..\..\$(RimworldVersion)\Achievements\Assemblies\</OutputPath>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE</DefineConstants>
	</PropertyGroup>

</Project>